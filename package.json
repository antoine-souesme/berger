{
  "name": "berger",
  "version": "1.0.0",
  "description": "Berger, le multiplexeur d'agents d'Antoine",
  "main": "./out/main/index.js",
  "author": "Antoine",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "install-electron",
    "test": "vitest run"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "lucide": "^1.72.0",
    "monaco-editor": "^0.57.0",
    "typescript": "^5.9.3",
    "typescript-language-server": "^6.0.3",
    "vscode-jsonrpc": "^10.0.0",
    "vscode-languageserver-protocol": "^3.18.5",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2",
    "yaml-language-server": "^2.0.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^24.19.2",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "vite": "^8.3.4",
    "vitest": "^5.1.0"
  }
}
